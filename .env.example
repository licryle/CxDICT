# CxDICT — LLM provider configuration template.
# Copy to `.env` (gitignored) and adjust. Plain environment variables
# override these values.
#
# LM Studio / OpenAI-compatible API configuration
LLM_API_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
LLM_MODEL_NAME=qwen3.5-9b-mtp
# Optional bearer token for providers that require auth (unused by local endpoints).
# LLM_API_KEY=sk-...

# Optional: entries per request, retries per batch, HTTP timeout seconds.
LLM_BATCH_SIZE=10
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=120
